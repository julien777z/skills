{
  "description": "Load the i-have-adhd and user-facing-output skills at session start, and at turn end create the session's ledger when none records it and check that every task ledger entry owing a backup comment has one.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/session-skills/main.py\" i-have-adhd",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/session-skills/main.py\" user-facing-output",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/ledger/main.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
